# Copy to .env for local development. Never commit real values.
PORT=3000
# development | staging | production
APP_ENV=development
# Sample fixture data is refused when APP_ENV=production.
RESOURCE_SOURCE=sample
# AI is off until explicitly enabled with a real server-side key.
AI_ENABLED=false
OPENROUTER_API_KEY=
AI_DAILY_LIMIT=40
# Set RESOURCE_SOURCE=co_resources for the existing resources table, or mariadb
# for the fc_resources integration table. Use SELECT-only credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldcompass
DB_USER=fieldcompass_reader
DB_PASSWORD=
# Required for remote database connections. Never disable certificate checks.
DB_TLS=false
DB_CA_FILE=
